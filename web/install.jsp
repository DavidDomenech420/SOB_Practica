<%@ page contentType="text/html" pageEncoding="UTF-8" %>
<%@ page import = "java.sql.*" %>

<!DOCTYPE html>
<html>
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
        <title>Database SQL Load</title>
    </head>
    <style>
        .error {
            color: red;
        }
        pre {
            color: green;
        }
    </style>
    <body>
        <h2>Database SQL Load</h2>
        <%
            /* How to customize:
             * 1. Update the database name on dbname.
             * 2. Create the list of tables, under tablenames[].
             * 3. Create the list of table definition, under tables[].
             * 4. Create the data into the above table, under data[]. 
             * 
             * If there is any problem, it will exit at the very first error.
             */
            String dbname = "sob_grup_36";
            String schema = "ROOT";
            Class.forName("org.apache.derby.jdbc.ClientDriver");
            /* this will generate database if not exist */
            Connection con = DriverManager.getConnection("jdbc:derby://localhost:1527/" + dbname, "root", "root");
            Statement stmt = con.createStatement();
            
            /* inserting data */
            /* you have to exclude the id autogenerated from the list of columns if you have use it. */
            String data[] = new String[]{
                "INSERT INTO " + schema + ".CREDENTIALS VALUES (NEXT VALUE FOR CREDENTIALS_GEN, 'sob', 'sob')",
                "INSERT INTO " + schema + ".CREDENTIALS (ID, USERNAME, PASSWORD) VALUES (NEXT VALUE FOR CREDENTIALS_GEN, 'david', '1234')",
                // 2. CUSTOMER
                "INSERT INTO " + schema + ".CUSTOMER (ID, USERNAME, EMAIL, FULLNAME, CREDENTIALS_ID) VALUES (NEXT VALUE FOR CUSTOMER_GEN, 'sob', 'sob@urv.cat', 'Usuari SOB', 1)",
                "INSERT INTO " + schema + ".CUSTOMER (ID, USERNAME, EMAIL, FULLNAME, CREDENTIALS_ID) VALUES (NEXT VALUE FOR CUSTOMER_GEN, 'david', 'david@urv.cat', 'David Domenech', 2)",

                // 3. TOOL (Mezclamos públicas y privadas para probar el filtrado y la ocultación de campos)
                "INSERT INTO " + schema + ".TOOL (ID, NAME, DESCRIPTION, LANGUAGE, CODE, VERSION, CREATIONDATE, ISPRIVATE, AUTHOR_ID) VALUES " +
                    "(NEXT VALUE FOR TOOL_GEN, 'Calculator', 'Calculadora basica en Python', 'Python', 'def add(a, b): return a + b', '1.0', CURRENT_TIMESTAMP, 0, 1)",
                "INSERT INTO " + schema + ".TOOL (ID, NAME, DESCRIPTION, LANGUAGE, CODE, VERSION, CREATIONDATE, ISPRIVATE, AUTHOR_ID) VALUES " +
                    "(NEXT VALUE FOR TOOL_GEN, 'SecretScraper', 'Extractor privado de datos', 'Python', 'import requests def scrape(url): pass', '2.1', CURRENT_TIMESTAMP, 1, 1)",
                "INSERT INTO " + schema + ".TOOL (ID, NAME, DESCRIPTION, LANGUAGE, CODE, VERSION, CREATIONDATE, ISPRIVATE, AUTHOR_ID) VALUES " +
                    "(NEXT VALUE FOR TOOL_GEN, 'JsonParser', 'Formateador JSON', 'Python', 'import json\\ndef parse(s): return json.loads(s)', '1.2', CURRENT_TIMESTAMP, 0, 2)",

                // 4. PROMPT (Uno público con herramientas y otro privado sin herramientas)
                "INSERT INTO " + schema + ".PROMPT (ID, TITLE, DESCRIPTION, TEMPLATE, CREATIONDATE, ISPRIVATE, AUTHOR_ID) VALUES " +
                    "(NEXT VALUE FOR PROMPT_GEN, 'Asistente Matematico', 'Resuelve operaciones usando herramientas', 'Usa la calculadora para resolver: {input}', CURRENT_TIMESTAMP, 0, 1)",
                "INSERT INTO " + schema + ".PROMPT (ID, TITLE, DESCRIPTION, TEMPLATE, CREATIONDATE, ISPRIVATE, AUTHOR_ID) VALUES " +
                    "(NEXT VALUE FOR PROMPT_GEN, 'Auditoria Interna', 'Prompt confidencial de analisis', 'Analiza el siguiente log privado: {log}', CURRENT_TIMESTAMP, 1, 2)",

                // 5. PROMPT_TAGS (Tabla auxiliar generada por @ElementCollection en Prompt)
                "INSERT INTO " + schema + ".PROMPT_TAGS (PROMPT_ID, TAGS) VALUES (1, 'math')",
                "INSERT INTO " + schema + ".PROMPT_TAGS (PROMPT_ID, TAGS) VALUES (1, 'python')",
                "INSERT INTO " + schema + ".PROMPT_TAGS (PROMPT_ID, TAGS) VALUES (2, 'security')",

                // 6. PROMPT_TOOL (Tabla intermedia definida en tu @JoinTable)
                "INSERT INTO " + schema + ".PROMPT_TOOL (PROMPT_ID, TOOL_ID) VALUES (1, 1)",
                "INSERT INTO " + schema + ".PROMPT_TOOL (PROMPT_ID, TOOL_ID) VALUES (1, 3)"
            };
            for (String datum : data) {
                if (stmt.executeUpdate(datum)<=0) {
                    out.println("<span class='error'>Error inserting data: " + datum + "</span>");
                    return;
                }
                out.println("<pre> -> " + datum + "<pre>");
            }
        %>
        <button onclick="window.location='<%=request.getSession().getServletContext().getContextPath()%>'">Go home</button>
    </body>
</html>
